# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and service-role key (Project Settings → API).
# Server-side only; do not prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required to call /api/ingest (Authorization: Bearer <CRON_SECRET>).
# Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# GNews API key (gnews.io dashboard). Free plan: 100 requests/day, 10 articles/request, 12-hour delay.
GNEWS_API_KEY=
