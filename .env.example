# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL (Project Settings → Data API) and secret key
# (Project Settings → API Keys → sb_secret_…, or the legacy service_role key).
# Server-side only; do not prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required to call /api/ingest (Authorization: Bearer <CRON_SECRET>).
# Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# GNews API key (gnews.io dashboard). Free plan: 100 requests/day, 10 articles/request, 12-hour delay.
GNEWS_API_KEY=

# Ask Watchtower (MVP3). Server-side only; never prefix with NEXT_PUBLIC_.
# Claude Console key scoped to the "Watchtower chatbot" workspace (US$5 monthly spend limit).
# For local eval runs, use the key scoped to "Watchtower tests" (US$10 limit) instead.
ANTHROPIC_API_KEY=

# Kill switch: only the exact value "true" turns Ask Watchtower on.
ASK_ENABLED=
